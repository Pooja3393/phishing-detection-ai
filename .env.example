# Optional: enables GPT-6 explanations. Scanning and model training work without this key.
OPENAI_API_KEY=your_openai_api_key_here

OPENAI_MODEL=gpt-6-luna
OPENAI_REASONING_EFFORT=low
# Dataset training is disabled unless the owner sets a private password in .env.
PHISHGUARD_ADMIN_PASSWORD=your_admin_password_here